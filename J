                    const q = phase1Questions[currentQuestionIndex];
                    document.getElementById("phase-badge").innerText = "前半：グループ絞り込みフェーズ";
                    document.getElementById("question-number").innerText = `質問 ${currentQuestionIndex + 1} / 全 16 問`;
                    document.getElementById("question-text").innerText = q.text;
                    
                    q.options.forEach(opt => {
                        const btn = document.createElement("button");
                        btn.className = "option-btn";
                        btn.innerText = opt.text;
                        btn.onclick = () => answerPhase1(opt.type);
                        container.appendChild(btn);
                    });
                } else {
                    // 前半8問終了 ➔ グループ決定して後半フェーズへ
                    selectedGroup = Object.keys(userScores).reduce((a, b) => userScores[a] > userScores[b] ? a : b);
                    currentPhase = 2;
                    currentQuestionIndex = 0;
                    showQuestion();
                }
            } else {
                // 【後半：8問】個人特定
                if (currentQuestionIndex < phase2Questions.length) {
                    const qKey = `Q${currentQuestionIndex + 1}`;
                    const qText = phase2Questions[currentQuestionIndex].text;
                    const optTexts = phase2OptionTexts[qKey];

                    document.getElementById("phase-badge").innerText = "後半：推しメン個人特定フェーズ";
                    document.getElementById("question-number").innerText = `質問 ${currentQuestionIndex + 9} / 全 16 問`;
                    document.getElementById("question-text").innerText = qText;
                    
                    optTexts.forEach((text, idx) => {
                        const btn = document.createElement("button");
                        btn.className = "option-btn";
                        btn.innerText = text;
                        btn.onclick = () => answerPhase2(idx);
                        container.appendChild(btn);
                    });
                } else {
                    // 全16問終了 ➔ 結果発表
                    showResult();
                }
            }
        }

        function answerPhase1(type) {
            userScores[type]++;
            currentQuestionIndex++;
            showQuestion();
        }

        function answerPhase2(charaIndex) {
            charaScores[charaIndex]++;
            currentQuestionIndex++;
            showQuestion();
        }

        function showResult() {
            document.getElementById("quiz-screen").classList.add("hidden");
            document.getElementById("result-screen").classList.remove("hidden");

            const memberList = groupCharacters[selectedGroup];
            
            // 後半8問の配点が一番高かったキャラクターを1人に決定
            let maxIndex = 0;
            for (let i = 1; i < charaScores.length; i++) {
                if (charaScores[i] > charaScores[maxIndex]) {
                    maxIndex = i;
                }
            }
            let finalChara = memberList[maxIndex];

            // 結果を画面に表示
            document.getElementById("result-name").innerText = currentUserName;
            document.getElementById("chara-name").innerText = `${finalChara.name} （${finalChara.school}）`;
            document.getElementById("chara-school").innerText = `【彼氏タイプ：${selectedGroup.toUpperCase()}】`;
            document.getElementById("chara-comment").innerText = finalChara.comment;

            // 診断履歴に追加してローカルストレージに保存
            diagnosisHistory.unshift({ name: currentUserName, chara: finalChara.name, school: finalChara.school });
            localStorage.setItem("tenipuri_history", JSON.stringify(diagnosisHistory));
            
            renderHistory();
        }

        function renderHistory() {
            const startList = document.getElementById("start-history-list");
            const resultList = document.getElementById("result-history-list");

            if (diagnosisHistory.length === 0) {
                const emptyMsg = `<p style="color: #999; text-align: center;">まだ診断履歴はありません</p>`;
                if(startList) startList.innerHTML = emptyMsg;
                if(resultList) resultList.innerHTML = emptyMsg;
                return;
            }

            let html = "";
            diagnosisHistory.forEach(item => {
                html += `
                    <div class="history-item">
                        <span>💖 <b>${item.name}</b> さん</span>
                        <span>➔ <b>${item.chara}</b> (${item.school})</span>
                    </div>
                `;
            });

            if(startList) startList.innerHTML = html;
            if(resultList) resultList.innerHTML = html;
        }

        function restartDiagnosis() {
            document.getElementById("result-screen").classList.add("hidden");
            document.getElementById("start-screen").classList.remove("hidden");
            document.getElementById("username").value = "";
            renderHistory();
        }
    </script>
</body>
</html>
