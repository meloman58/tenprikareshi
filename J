        <!-- スタート画面 -->
        <div id="start-screen">
            <h1>🎾 テニプリ彼氏診断 👑</h1>
            <p>【前半8問 ➔ 後半8問】の全16問で、<br>あなたの運命の王子様（中学レギュラー）を1人に特定します！<br>お名前を入力してスタートしてね。</p>
            <input type="text" id="username" placeholder="例：あなたのお名前"><br>
            <button onclick="startDiagnosis()">診断スタート！</button>

            <!-- 初開時も履歴を表示 -->
            <div class="history-section">
                <h3 style="font-size: 14px; margin-bottom: 8px; color: var(--accent-color);">📜 みんなの診断履歴一覧</h3>
